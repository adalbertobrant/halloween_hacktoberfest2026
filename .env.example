# Configurações da Aplicação Memorial
RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Opções: 'ollama' (local) ou 'external' (serviços externos)
AI_PROVIDER=ollama

# Ollama Local (se rodando na máquina host)
OLLAMA_HOST=host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Modelos disponíveis no seu Ollama
MEMORIAL_AGENT_MODEL=gemma4:e4b
WEBBUILDER_AGENT_MODEL=gemma4:e4b
EVENT_AGENT_MODEL=gemma3:4b
DISPATCH_AGENT_MODEL=gemma3:4b
ORCHESTRATOR_MODEL=gemma4:e4b

# Temperaturas
MEMORIAL_TEMPERATURE=0.3
WEBBUILDER_TEMPERATURE=0.2
EVENT_TEMPERATURE=0.1
DISPATCH_TEMPERATURE=0.1

# Serviços Externos (opcionais - caso queira usar)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Sentry/OpenTelemetry (opcional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=memorial-ai-system

# App Config
APP_HOST=localhost
APP_PORT=3000
