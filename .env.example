# MemorialAvisos - Environment Configuration

# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Temporal Workflow Engine
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# Redis Cache
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------

# Options: 'ollama' (local, recommended) or 'external' (not yet implemented)
AI_PROVIDER=ollama

# -----------------------------------------------------------------------------
# OLLAMA (Local Open-Weight Models) - RECOMMENDED
# -----------------------------------------------------------------------------
# Make sure Ollama is running on your host machine and has these models pulled:
#   ollama pull gemma4:e4b
#   ollama pull gemma3:4b
#
# When using Docker, host.docker.internal allows containers to reach your host
OLLAMA_HOST=host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models per agent (must match models available in your Ollama instance)
MEMORIAL_AGENT_MODEL=gemma4:e4b      # Best for empathetic memorial writing
WEBBUILDER_AGENT_MODEL=gemma4:e4b    # Best for clean HTML/CSS/JS
EVENT_AGENT_MODEL=gemma3:4b          # Best for factual/logistics
DISPATCH_AGENT_MODEL=gemma3:4b       # Best for short notifications
ORCHESTRATOR_MODEL=gemma4:e4b

# Temperature per agent (lower = more deterministic, higher = more creative)
MEMORIAL_TEMPERATURE=0.3
WEBBUILDER_TEMPERATURE=0.2
EVENT_TEMPERATURE=0.1
DISPATCH_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# EXTERNAL AI PROVIDERS (OPTIONAL - NOT YET WIRED IN THIS BUILD)
# -----------------------------------------------------------------------------
# These keys are reserved for future use. Currently call_external() falls back
# to Ollama. If you want to use them, you'll need to extend lib/ai_providers/base_provider.rb
# 
# GEMINI_API_KEY=                # Google Gemini
# OPENROUTER_API_KEY=            # OpenRouter (access to many models)
# GROQ_API_KEY=                  # Groq (fast inference)

# -----------------------------------------------------------------------------
# OBSERVABILITY (OPTIONAL)
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=memorial-ai-system

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
APP_HOST=localhost
APP_PORT=80
